{
  "name": "open-space",
  "version": "1.22.4",
  "private": true,
  "description": "Un bureau en pixel art pour piloter plusieurs sessions Claude Code en même temps, depuis le navigateur.",
  "author": "Fantomiald",
  "license": "MIT",
  "homepage": "https://github.com/Fantomiald/open-space#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fantomiald/open-space.git"
  },
  "bugs": "https://github.com/Fantomiald/open-space/issues",
  "keywords": [
    "claude-code",
    "claude",
    "agents",
    "pixel-art",
    "dashboard"
  ],
  "type": "module",
  "main": "out/desktop/main.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node scripts/check-node.mjs && vite build --logLevel warn && node server/index.ts --open",
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "serve": "node server/index.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p desktop/tsconfig.json",
    "lint": "biome lint",
    "test": "node --test \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"src/**/*.test.ts\"",
    "app:build": "node scripts/clean-app.mjs && vite build --outDir out/dist --emptyOutDir --logLevel warn && vite build -c vite.desktop.config.ts --logLevel warn && node scripts/copy-desktop-assets.mjs",
    "app:dev": "npm run app:build && electron .",
    "app": "npm run app:build && electron-builder --mac -c.mac.identity=-",
    "app:release": "npm run app:build && electron-builder --mac",
    "app:publish": "npm run app:build && electron-builder --mac --win --publish always",
    "app:win": "npm run app:build && electron-builder --win --x64",
    "app:win:arm64": "npm run app:build && electron-builder --win --arm64"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "lucide-react": "1.50.0",
    "marked": "^18.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
