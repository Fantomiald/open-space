<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- what Electron needs under the hardened runtime (V8's JIT) -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- an ad hoc signature (npm run app) has no team to validate the Electron frameworks against -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- osascript for Music, Spotify and the terminal (server/music.ts, server/desktop.ts) -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
